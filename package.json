{
  "name": "cinebridge-recomendacao",
  "version": "0.1.0",
  "description": "Microsserviço de recomendação e orquestração de equipes - plataforma cinebridge",
  "main": "dist/interfaces/http/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/interfaces/http/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/interfaces/http/server.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typeorm": "typeorm-ts-node-commonjs",
    "benchmark": "npm run build && node scripts/benchmark.js"
  },
  "keywords": [
    "cinebridge",
    "recomendacao",
    "microsservico"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
